{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Timetable",
  "version": "0.4.0",
  "identifier": "com.maxsalmon.timetable",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev -- --port 1420 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Timetable",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#ECE7FB",
        "trafficLightPosition": {
          "x": 34,
          "y": 30
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "Developer ID Application: Max Salmon (DR6GPTU9UX)",
      "entitlements": "Entitlements.plist"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3MUMxMTJBRTg1NTU4RjAKUldUd1dGWG9LaEVjTjFxRmhITCtsNTNWUUtpakpMN0ZoYU0yTytScy9hRVF5UHIrNUg5Y2grckwK",
      "endpoints": [
        "https://github.com/maxsalmon1999-cloud/timetable/releases/latest/download/latest.json"
      ]
    }
  }
}
