rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each account can read and write only its own plans (users/<uid>/items/<key>, see src/lib/syncModel.ts).
    match /users/{uid}/items/{key} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Password hints (src/lib/cloud.ts): anyone may read one (it's shown on the sign-in screen); only the account that
    // made it may change or delete it; just a short hint and the owner's id.
    match /hints/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['hint', 'uid', 'at'])
        && request.resource.data.hint is string && request.resource.data.hint.size() <= 120;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['hint', 'uid', 'at'])
        && request.resource.data.hint is string && request.resource.data.hint.size() <= 120;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
